# Copy this file to .env and fill it in. .env is git-ignored: never commit real keys.

# --- Postgres (all state is saved here) ---
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/mtm_hackathon

# --- Reading engine ---
# openai    = any OpenAI-compatible API (Groq, Ollama, ...)   <- recommended
# anthropic = Claude via ANTHROPIC_API_KEY
# rules     = free offline engine, no key, 0 tokens (understands only common phrasings)
LLM_PROVIDER=openai

# Groq (free tier: 8000 tokens/minute). `openai/gpt-oss-20b` is a small reasoning model.
LLM_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_groq_key_here
# gpt-oss "thinks" before answering: keep this low or it spends all tokens thinking and returns nothing.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=2800

# Ollama instead:  LLM_PROVIDER=openai  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
# Claude instead:  LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-5-5  ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

LLM_TIMEOUT_SECONDS=45
# An input with at least this many messages starts a fresh plan; fewer = an update to the current plan.
PACK_MIN_MESSAGES=4
