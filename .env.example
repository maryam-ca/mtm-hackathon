# --- Postgres (all state is saved here) ---
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/mtm_hackathon

# --- Reading engine ---
# "rules"     = free offline engine, no key, 0 tokens (limited to common phrasings)
# "anthropic" or "openai" (any OpenAI-compatible server, e.g. Groq/Ollama) = a real model
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# For Ollama / OpenAI-compatible:
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5:7b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

LLM_TIMEOUT_SECONDS=45
# A new input with at least this many messages starts a fresh plan; fewer = update.
PACK_MIN_MESSAGES=4
